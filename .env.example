# ── Google AI Studio (Gemini) ─────────────────────────────────────────────
# OPTIONAL — the app now prompts you for the key in the browser on first launch
# and stores it in localStorage. Set this here only if you want a shared
# server-side fallback (e.g. for a deployed instance). Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────
# Port for the Express backend. Azure App Service injects PORT automatically.
PORT=3000

# ── Optional: SharePoint / OneDrive integration ───────────────────────────
# Generated videos auto-upload here when configured. Requires an Entra ID
# app registration with application permissions:
#   - Sites.ReadWrite.All (or Sites.Selected, see deployment doc)
# and admin consent granted in your tenant.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# e.g. "playtika.sharepoint.com"
MS_SHAREPOINT_HOSTNAME=
# e.g. "/sites/Marketing"  (leave blank for the root site)
MS_SHAREPOINT_SITE_PATH=
# Folder inside the site's default document library
MS_SHAREPOINT_FOLDER=Art Studio
